{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "description": "Claude Desktop",
      "groupName": "claude",
      "matchPackageNames": ["claude-desktop"],
      "automerge": true
    },
    {
      "description": "7-Zip",
      "groupName": "7zip",
      "matchPackageNames": ["7zip", "ip7z/7zip"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Claude Desktop .deb URLs (Anthropic's APT repo)",
      "managerFilePatterns": [
        "/\\/ai\\.claude\\.Claude\\.yaml$/"
      ],
      "matchStrings": [
        "url: https://downloads\\.claude\\.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_(?<currentValue>[\\d.]+)_"
      ],
      "depNameTemplate": "claude-desktop",
      "datasourceTemplate": "deb",
      "registryUrlTemplate": "https://downloads.claude.ai/claude-desktop/apt/stable?suite=stable&components=main&binaryArch=amd64",
      "versioningTemplate": "loose",
      "autoReplaceStringTemplate": "url: https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_{{{newValue}}}_"
    },
    {
      "customType": "regex",
      "description": "7-Zip Linux archive URLs",
      "managerFilePatterns": [
        "/\\/ai\\.claude\\.Claude\\.yaml$/"
      ],
      "matchStrings": [
        "url: https://github\\.com/ip7z/7zip/releases/download/(?<currentValue>[\\d.]+)/7z\\d+-linux-"
      ],
      "depNameTemplate": "7zip",
      "packageNameTemplate": "ip7z/7zip",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose",
      "autoReplaceStringTemplate": "url: https://github.com/ip7z/7zip/releases/download/{{{newValue}}}/7z{{{replace '\\.' '' newValue}}}-linux-"
    },
    {
      "customType": "regex",
      "description": "freedesktop-sdk runtime version (manifest and CI image)",
      "managerFilePatterns": [
        "/\\/ai\\.claude\\.Claude\\.yaml$/",
        "/\\.github\\/workflows\\/flatpak-build\\.yaml$/"
      ],
      "matchStrings": [
        "runtime-version: \"(?<currentValue>[\\d.]+)\"",
        "base-version: \"(?<currentValue>[\\d.]+)\"",
        "image: ghcr.io/flathub-infra/flatpak-github-actions:freedesktop-(?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "org.freedesktop.Sdk",
      "datasourceTemplate": "custom.flathub-runtime",
      "versioningTemplate": "loose"
    }
  ],
  "customDatasources": {
    "flathub-runtime": {
      "defaultRegistryUrlTemplate": "https://flathub.org/api/v2/runtimes",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $each($$, function($v, $k) { $k })[$contains(\"org.freedesktop.Sdk/x86_64/\")] ~> $map(function($k) { { \"version\": $split($k, \"/\")[2] } }) }"
      ]
    }
  }
}
