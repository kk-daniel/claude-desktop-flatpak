#!/usr/bin/env bash
set -euo pipefail

cd /app/extra

# Unpack inside /app/extra rather than /tmp: the payload is ~520 MB, and
# keeping the work dir on the destination filesystem makes the final step a
# rename instead of a second full-size copy.
work_dir="/app/extra/.unpack"
trap 'rm -rf "$work_dir"' EXIT
rm -rf "$work_dir"
mkdir -p "$work_dir"

deb=""
for candidate in claude-desktop-amd64.deb claude-desktop-arm64.deb; do
  if [ -f "$candidate" ]; then
    deb="$candidate"
    break
  fi
done

if [ -z "$deb" ]; then
  echo "Claude Desktop .deb not found in /app/extra" >&2
  exit 1
fi

# binutils' `ar` is SDK-only and apply_extra runs against the Platform runtime,
# so 7z does the unwrapping: it walks the ar container and the xz stream in one
# pass and writes data.tar. tar then restores the exec bits and the single
# symlink the payload carries.
7z x -y "$deb" -o"$work_dir" >/dev/null
if [ ! -f "$work_dir/data.tar" ]; then
  echo "data.tar not found in $deb" >&2
  exit 1
fi

tar xf "$work_dir/data.tar" -C "$work_dir" ./usr/lib/claude-desktop
rm -f "$work_dir/data.tar"

payload="$work_dir/usr/lib/claude-desktop"
if [ ! -f "$payload/resources/app.asar" ]; then
  echo "app.asar not found in $deb payload" >&2
  exit 1
fi

# The .deb ships the app and its Electron in one directory, laid out exactly
# how Electron expects: the binary resolves app.asar and process.resourcesPath
# from <exe_dir>/resources. Moving the tree wholesale keeps that intact.
rm -rf claude
mv "$payload" claude

# Drop the suid sandbox helper: zypak provides namespace sandboxing via
# CHROME_DEVEL_SANDBOX, and Chromium aborts if it sees a non-setuid
# chrome-sandbox sitting next to the binary.
rm -f claude/chrome-sandbox

chmod +x claude/claude-desktop claude/chrome_crashpad_handler

rm -f /app/extra/claude-desktop-amd64.deb /app/extra/claude-desktop-arm64.deb
echo "Claude Desktop extra data installed"
